    "joint_acceleration_rad_s2": [3.0, 3.0, 3.0, 4.0, 4.0, 3.0, 3.0, 3.0, 3.0, 3.0, 4.0, 4.0, 3.0, 3.0],
    "joint_jerk_rad_s3": [20.0, 20.0, 20.0, 25.0, 25.0, 20.0, 20.0, 20.0, 20.0, 20.0, 25.0, 25.0, 20.0, 20.0],
    "joint_target_natural_frequency_rad_s": 15.0,
    "joint_limit_margin_deg": 5.0,
    "tcp_displacement_from_start_m": 0.25,
    "tcp_linear_speed_m_s": 0.62,
    "tcp_angular_speed_rad_s": 2.129301687,
    "tcp_single_frame_jump_m": 0.15,
