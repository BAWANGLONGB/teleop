    "q_deg": [90, -90, 90, 20, -90, 0, 0, -90, -90, -90, 20, 90, 0, 0],
    "shared_with_mujoco": true,
    "move_before_arming": true,
    "source": "detected_feedback_pose",
    "duration_s": 10.0,
    "requires_startup_path_clear_confirmation": true,
    "completion_tolerance_deg": 0.5
  },
  "rates_hz": {
    "xr_poll": 200,
    "ik_control": 200,
    "feedback": 200,
    "hardware_command_initial": 200,
    "hardware_command_max_vendor": 200
